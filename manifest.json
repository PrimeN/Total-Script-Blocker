{
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "description": "Block scripts, frames, and objects by default. Allow trusted domains permanently or for this browser session.",
  "icons": {
    "128": "img/icon128.png",
    "16": "img/icon16.png",
    "19": "img/forbidden.png",
    "48": "img/icon48.png"
  },
  "name": "Total Script Blocker",
  "minimum_chrome_version": "120",
  "options_page": "options.html",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "offscreen",
    "tabs",
    "webRequest",
    "webNavigation",
    "scripting",
    "browsingData",
    "alarms"
  ],
  "version": "2.0.0",
  "action": {
    "default_icon": "img/disabled.png",
    "default_popup": "popup.html",
    "default_title": "Total Script Blocker"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "incognito": "not_allowed",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "baseline",
        "enabled": true,
        "path": "rules/baseline.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "discover.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "key": ""
}
